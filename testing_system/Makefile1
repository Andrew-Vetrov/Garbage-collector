LIB_NAME = lib.a

CC = gcc

CFLAGS = -w

SRC = allocator/allocator.c allocator/small-objs-heap.c allocator/big-objs-heap.c \
	scanner/marking.c scanner/stack.c logging/log.c mt-safety/threads-storage.c \
	mt-safety/mt-safety.c
	
OBJ = $(SRC:.c=.o)

BUILD_DIR = build

all: $(LIB_NAME)

$(LIB_NAME): $(OBJ)
	ar rcs $@ $^

%.o: %.c
	$(CC) -c $^ -DHEAP_SIZE=65536 $(CFLAGS) -o $@

clean:
	rm $(OBJ) $(LIB_NAME)
